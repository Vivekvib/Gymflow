+          <CardTitle className="mt-0.5 text-base">{day.title}</CardTitle>
+        </div>
+        {isToday ? (
+          <Badge className="shrink-0 bg-[var(--color-accent)] text-[var(--color-accent-ink)]">Today</Badge>
