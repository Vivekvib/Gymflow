// Prisma ORM v7 schema.
// NOTE: the database connection URL lives in prisma.config.ts, not here -
// that's a v7 change, not an oversight.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A single gym location. Every tenant-owned model below carries a gymId so
/// the schema does not need to change when a second location is added -
/// only the application needs to start creating more than one row here.
model Gym {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  address   String?
  city      String?
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins             Admin[]
  members            Member[]
  payments           Payment[]
  attendanceDevices  AttendanceDevice[]
  attendances        Attendance[]
  auditLogs          AuditLog[]
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(cuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recordedPayments Payment[]  @relation("PaymentRecordedByAdmin")
  auditLogs        AuditLog[]

  @@index([gymId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Member {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id])

  /// Human-friendly ID shown on membership cards / used for member login,
  /// e.g. "GYM-0001". Generated by src/modules/members/member-id.ts.
  memberCode String  @unique

  name                  String
  phone                 String    @unique
  email                 String?
  passwordHash          String
  gender                Gender?
  dateOfBirth           DateTime?
  heightCm              Float?
  emergencyContactName  String?
  emergencyContactPhone String?

  joinDate DateTime @default(now())

  /// Denormalized from the member's payment history so membership status
  /// can be read without joining Payment on every dashboard/list render.
  /// Always written inside the same transaction as the Payment that
  /// changes it - see modules/payments/service.ts.
  membershipStart DateTime?
  membershipEnd   DateTime?

  /// Admin-controlled kill switch, independent of membership expiry - a
  /// member can be deactivated (e.g. banned) even mid-membership.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments            Payment[]
  weightLogs          WeightLog[]
  measurementLogs     MeasurementLog[]
  goal                Goal?
  workoutPlans        WorkoutPlan[]
  workoutCompletions  WorkoutCompletion[]
  attendances         Attendance[]

  @@index([gymId])
  @@index([gymId, active])
  @@index([gymId, membershipEnd])
}

// ---------------------------------------------------------------------------
// Payments & membership
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  RAZORPAY
  STRIPE
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id    String @id @default(cuid())
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id])

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  /// Amount stored in paise (smallest currency unit) - never floats for money.
  amountPaise Int

  method   PaymentMethod
  provider PaymentProvider?

  /// Populated once an online-payment adapter (Razorpay/Stripe) is wired in;
  /// null for cash/UPI/card-in-person entries recorded by an admin.
  providerPaymentId String?
  providerOrderId   String?
  status            PaymentStatus @default(SUCCESS)

  planDurationDays Int

  paymentDate DateTime @default(now())

  /// The membership window this specific payment produced. See
  /// calculateMembershipExtension() in modules/payments/service.ts for how
  /// these are derived (extends from current expiry if still active,
  /// otherwise from the payment date).
  membershipStartAfter DateTime
  membershipEndAfter   DateTime

  notes String?

  recordedByAdminId String?
  recordedByAdmin   Admin? @relation("PaymentRecordedByAdmin", fields: [recordedByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([gymId, memberId])
  @@index([gymId, paymentDate])
}

// ---------------------------------------------------------------------------
// Fitness progress
// ---------------------------------------------------------------------------

model WeightLog {
  id       String @id @default(cuid())
  gymId    String
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  date     DateTime @default(now())
  weightKg Float
  notes    String?

  createdAt DateTime @default(now())

  @@index([gymId, memberId, date])
}

model MeasurementLog {
  id       String @id @default(cuid())
  gymId    String
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  date     DateTime @default(now())
  waistCm  Float?
  chestCm  Float?
  hipCm    Float?
  armCm    Float?
  thighCm  Float?
  notes    String?

  createdAt DateTime @default(now())

  @@index([gymId, memberId, date])
}

enum GoalType {
  LOSE
  GAIN
  MAINTAIN
  FITNESS
}

model Goal {
  id       String @id @default(cuid())
  gymId    String
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id])

  goalType       GoalType
  targetWeightKg Float?
  targetDate     DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Workouts
// ---------------------------------------------------------------------------

model WorkoutPlan {
  id       String @id @default(cuid())
  gymId    String
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  title  String
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days WorkoutPlanDay[]

  @@index([gymId, memberId])
}

model WorkoutPlanDay {
  id            String      @id @default(cuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek Int
  title     String
  order     Int    @default(0)

  exercises   PlanExercise[]
  completions WorkoutCompletion[]

  @@index([workoutPlanId])
}

model PlanExercise {
  id               String         @id @default(cuid())
  workoutPlanDayId String
  workoutPlanDay   WorkoutPlanDay @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)

  name        String
  sets        Int
  /// Free text so "8-12" and "AMRAP" both work without a second column.
  reps        String
  restSeconds Int?
  order       Int    @default(0)
  notes       String?

  @@index([workoutPlanDayId])
}

model WorkoutCompletion {
  id               String         @id @default(cuid())
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id])
  workoutPlanDayId String
  workoutPlanDay   WorkoutPlanDay @relation(fields: [workoutPlanDayId], references: [id])

  completedDate DateTime @default(now())
  notes         String?

  createdAt DateTime @default(now())

  @@index([memberId, completedDate])
}

// ---------------------------------------------------------------------------
// Attendance (schema modeled ahead of the UI - see README)
// ---------------------------------------------------------------------------

model AttendanceDevice {
  id         String @id @default(cuid())
  gymId      String
  gym        Gym    @relation(fields: [gymId], references: [id])
  name       String
  deviceCode String @unique
  location   String?

  createdAt DateTime @default(now())

  attendances Attendance[]

  @@index([gymId])
}

enum AttendanceSource {
  MANUAL
  FINGERPRINT
  QR
  API
}

model Attendance {
  id       String @id @default(cuid())
  gymId    String
  gym      Gym    @relation(fields: [gymId], references: [id])
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  deviceId String?
  device   AttendanceDevice? @relation(fields: [deviceId], references: [id])

  source           AttendanceSource @default(MANUAL)
  /// The device's own record ID, if any - used to make repeated device
  /// submissions idempotent at the application layer.
  externalRecordId String?
  checkedInAt      DateTime         @default(now())
  metadata         Json?

  createdAt DateTime @default(now())

  @@index([gymId, memberId, checkedInAt])
  @@index([deviceId, externalRecordId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditActorType {
  ADMIN
  SYSTEM
}

model AuditLog {
  id      String @id @default(cuid())
  gymId   String
  gym     Gym    @relation(fields: [gymId], references: [id])

  actorType  AuditActorType
  actorId    String?
  adminActor Admin? @relation(fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([gymId, createdAt])
}
