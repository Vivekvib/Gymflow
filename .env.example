# Postgres connection string used by the app at runtime (pooled, if your host offers it).
# On Neon: the connection string with "-pooler" in the hostname.
DATABASE_URL="postgresql://gym:gym@localhost:5432/gymflow"

# Direct (non-pooled) connection used by the Prisma CLI (migrate, studio, db pull) -
# see prisma.config.ts. On Neon: the connection string WITHOUT "-pooler" in the
# hostname - Neon's dashboard shows both under Connection Details. This must be
# genuinely different from DATABASE_URL on Neon/Supabase, not the same value twice -
# a pooled connection doesn't reliably support the locks Prisma Migrate needs.
DIRECT_URL="postgresql://gym:gym@localhost:5432/gymflow"

# 48+ bytes of random data, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GYM_NAME="Your Gym"
NEXT_PUBLIC_GYM_PHONE="+91XXXXXXXXXX"
NEXT_PUBLIC_GYM_EMAIL="gym@example.com"

# Uncomment once the Razorpay adapter is wired up (see src/modules/payments/providers).
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
