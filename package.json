    "lucide-react": "^0.474.0",
    "next": "^16.2.6",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
